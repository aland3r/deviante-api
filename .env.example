# Supabase — API JDBC (Deviante / Ktor)
# Copy to .env and set DATABASE_PASSWORD (never commit .env)
#
# Supabase → Project Settings → Database → Connection string
# Use "Session pooler" (port 5432) for Ktor / Exposed.

DATABASE_JDBC_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.ydjtrcjxhtmygytmebrk
DATABASE_PASSWORD=your-database-password

# Direct (non-pooler) alternative:
# DATABASE_JDBC_URL=jdbc:postgresql://db.ydjtrcjxhtmygytmebrk.supabase.co:5432/postgres?sslmode=require
# DATABASE_USER=postgres

# Supabase Auth — used to verify the bearer token the web app sends
# (GET {SUPABASE_URL}/auth/v1/user). anon/publishable key only — never the
# service_role key here.
SUPABASE_URL=https://ydjtrcjxhtmygytmebrk.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Process-mining service (deviante/mining) — parses uploaded event logs.
# Local default is http://localhost:8000; set this in production to wherever
# the FastAPI service is deployed. Uploads fail with 503 if it is unreachable.
MINING_SERVICE_URL=http://localhost:8000
